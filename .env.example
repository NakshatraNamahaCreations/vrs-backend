# --- Server ---
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# --- MongoDB ---
MONGO_URI=mongodb://127.0.0.1:27017/vrs

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
OTP_TTL_MINUTES=10

# --- SMS (optional — leave blank to log OTP to console) ---
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=VRSWTR

# --- Admin bootstrap (used by `npm run seed:admin`) ---
ADMIN_EMAIL=admin@vrswaterpurifiers.in
ADMIN_PASSWORD=change-me-on-first-login
ADMIN_NAME=VRS Admin

# --- Admin panel origin (allowed in CORS) ---
ADMIN_ORIGIN=http://localhost:3001

# --- Image uploads (Cloudinary) ---
# One-var form (copy from your Cloudinary dashboard):
#   cloudinary://<api_key>:<api_secret>@<cloud_name>
# Leave blank to fall back to local disk storage (dev only — won't work on
# serverless / Vercel).

# Or set these three individually instead of CLOUDINARY_URL:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Razorpay (test keys from https://dashboard.razorpay.com/app/keys) ---
# Use rzp_test_* keys in development; rzp_live_* in production.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Order confirmation email (Gmail SMTP) ---
# Prerequisites for Gmail:
#   1. Turn on 2-Step Verification: https://myaccount.google.com/security
#   2. Generate an App Password:    https://myaccount.google.com/apppasswords
#      (16 characters, no spaces — paste it into SMTP_PASS below.)
#   3. Keep SMTP_USER and the address inside MAIL_FROM identical — Gmail
#      refuses to send with a From that doesn't match the authenticated
#      account, so mismatched values silently fail.
#
# Any other SMTP provider works too (SendGrid, Postmark, Zoho, etc.) —
# just swap the host/port/credentials.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=abhishek900815@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
MAIL_FROM="VRS Water Purifiers <abhishek900815@gmail.com>"

# Owner / ops team internal order alert. Comma-separated list of addresses
# that receive a "new paid order" email whenever a customer's payment is
# verified. Leave blank to skip the owner alert.
# Example: ORDER_NOTIFY_EMAIL=orders@vrswaterpurifiers.in,ravi@vrswaterpurifiers.in
ORDER_NOTIFY_EMAIL=abhishek900815@gmail.com
