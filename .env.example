# --- Server ---
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# --- MongoDB ---
MONGO_URI=mongodb://127.0.0.1:27017/vrs

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
OTP_TTL_MINUTES=10

# --- SMS (optional — leave blank to log OTP to console) ---
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=VRSWTR

# --- Admin bootstrap (used by `npm run seed:admin`) ---
ADMIN_EMAIL=admin@vrswaterpurifiers.in
ADMIN_PASSWORD=change-me-on-first-login
ADMIN_NAME=VRS Admin

# --- Admin panel origin (allowed in CORS) ---
ADMIN_ORIGIN=http://localhost:3001

# --- Image uploads (Cloudinary) ---
# One-var form (copy from your Cloudinary dashboard):
#   cloudinary://<api_key>:<api_secret>@<cloud_name>
# Leave blank to fall back to local disk storage (dev only — won't work on
# serverless / Vercel).

# Or set these three individually instead of CLOUDINARY_URL:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Razorpay (test keys from https://dashboard.razorpay.com/app/keys) ---
# Use rzp_test_* keys in development; rzp_live_* in production.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Order confirmation email (SMTP) ---
# Any SMTP provider works — Gmail, SendGrid, Postmark, Zoho, etc.
# Leave blank to skip email sends (a warning is logged instead).
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
#   SMTP_PASS=<app password from https://myaccount.google.com/apppasswords>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="VRS Water Purifiers <no-reply@vrswaterpurifiers.in>"
