# --- Server ---
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# --- MongoDB ---
MONGO_URI=mongodb://127.0.0.1:27017/vrs

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
OTP_TTL_MINUTES=10

# --- SMS (optional — leave blank to log OTP to console) ---
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=VRSWTR

# --- Admin bootstrap (used by `npm run seed:admin`) ---
ADMIN_EMAIL=admin@vrswaterpurifiers.in
ADMIN_PASSWORD=change-me-on-first-login
ADMIN_NAME=VRS Admin

# --- Admin panel origin (allowed in CORS) ---
ADMIN_ORIGIN=http://localhost:3001

# --- Image uploads (Cloudinary) ---
# One-var form (copy from your Cloudinary dashboard):
#   cloudinary://<api_key>:<api_secret>@<cloud_name>
# Leave blank to fall back to local disk storage (dev only — won't work on
# serverless / Vercel).

# Or set these three individually instead of CLOUDINARY_URL:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
